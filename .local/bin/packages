#!/usr/bin/env bash
# Arch package maintenance. Execute this file; do not source it.
error() {
	printf 'ERROR: %s\n' "$*" >&2
}
msg() {
	printf '==> %s\n' "$*"
}
msg2() {
	printf '  -> %s\n' "$*"
}
ask() {
	printf '%s' "$*"
}
plain() {
	printf '%s\n' "$*"
}

# Arch package helpers. Dependencies are checked when commands are invoked.
_pkg_require() {
	local dependency
	for dependency in "$@"; do
		if ! command -v "$dependency" >/dev/null 2>&1; then
			error "Required command is not installed: ${dependency}"
			return 2
		fi
	done
}

aursync() {
	_pkg_require aur || return 2
	command aur sync --noview --chroot --sign --remove "$@"
}

update() {
	local updates exit_code
	if [[ ${1:-} == aur ]]; then
		aursync -u || return 1
	fi
	_pkg_require checkupdates || return 2
	ask 'Checking for updates...'
	if updates=$(command checkupdates); then
		exit_code=0
	else
		exit_code=$?
	fi
	plain 'Done'
	# checkupdates returns 2 when no updates are available.
	if (( exit_code == 2 )); then
		msg 'No updates available'
		return 0
	elif (( exit_code != 0 )); then
		error 'Unable to check for updates'
		return 1
	fi
	if [[ -z $updates ]]; then
		msg 'No updates available'
		return 0
	fi
	if printf '%s\n' "$updates" | command grep -q '^archlinux-keyring '; then
		msg 'Updating keyring'
		command sudo pacman -Sy archlinux-keyring || return 1
	fi
	command sudo pacman -Syu
}

# Callers declare these three locals; Bash and zsh both use dynamic scoping.
_pkg_get_params() {
	local repo_parameters
	_pkg_require aur || return 1
	repo_parameters=$(command aur repo) || return 1
	repo_name=$(printf '%s\n' "$repo_parameters" | sed -n 's/^repo://p')
	repo_root=$(printf '%s\n' "$repo_parameters" | sed -n 's/^root://p')
	repo_path=$(printf '%s\n' "$repo_parameters" | sed -n 's/^path://p')
	if [[ -z $repo_name || ! -d $repo_root || -z $repo_path ]]; then
		error 'Unable to determine local repository parameters'
		return 1
	fi
}

_pkg_require_key() {
	[[ -n ${GPGKEY:-} ]] && return 0
	error 'GPGKEY environment variable is not set'
	return 1
}

_pkg_sign_file() {
	command gpg --detach-sign --no-armor --batch --yes -u "$GPGKEY" -- "$1"
}

pkgadd() {
	local repo_name repo_root repo_path package package_directory package_path
	if ! (( $# > 0 )); then
		error 'Usage: packages add package-file ...'
		return 1
	fi
	_pkg_require_key || return 1
	_pkg_get_params || return 2
	for package in "$@"; do
		if [[ ! -f $package ]]; then
			error "Package does not exist: ${package}"
			return 1
		fi
		if [[ ! -f ${package}.sig ]]; then
			_pkg_sign_file "$package" || return 3
		fi
		package_path=$(realpath -- "$package") || return 1
		package_directory=$(dirname -- "$package_path") || return 1
		if [[ $package_directory != "$repo_root" ]]; then
			command cp -i -- "$package" "${package}.sig" "$repo_root" || return 1
		fi
	done
	command repo-add --sign --key "$GPGKEY" "$repo_path" "$@"
}

pkgdel() {
	local repo_name repo_root repo_path
	if (( $# == 0 )); then
		error 'Usage: packages remove package-name ...'
		return 1
	fi
	_pkg_require_key || return 1
	_pkg_require repo-remove || return 1
	_pkg_get_params || return 1
	command repo-remove --sign --key "$GPGKEY" --remove "$repo_path" "$@"
}

pkgverify() {
	local repo_name repo_root repo_path package package_name
	local -a not_installed=()
	_pkg_get_params || return 1
	msg 'Comparing local package files to installed packages...'
	while IFS= read -r -d '' package; do
		package_name=$(command pacman -Qpq -- "$package") || return 1
		[[ $package_name == *-debug ]] && continue
		if ! command pacman -Qq -- "$package_name" >/dev/null 2>&1; then
			not_installed+=("$package_name")
		fi
	done < <(find "$repo_root" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' -print0)
	if (( ${#not_installed[@]} > 0 )); then
		msg 'The following package files are not installed:'
		for package_name in "${not_installed[@]}"; do msg2 "$package_name"; done
		return 1
	fi
	msg2 'No superfluous packages exist in the local repository'
}

# Enumerate files with find so empty globs work with failglob and nomatch.
_pkg_sign_databases() {
	local database exit_code=0 found=0
	while IFS= read -r -d '' database; do
		found=1
		_pkg_sign_file "$database" || exit_code=3
	done < <(find -L "$repo_root" -maxdepth 1 -type f \
		\( -name "${repo_name}.db*" -o -name "${repo_name}.files*" \) ! -name '*.sig' -print0)
	if (( found == 0 )); then
		error 'No database files found'
		return 2
	fi
	return "$exit_code"
}

localdbsign() {
	local repo_name repo_root repo_path
	_pkg_require_key || return 1
	_pkg_get_params || return 2
	msg 'Signing all database files...'
	_pkg_sign_databases
}

fixlocaldb() {
	local repo_name repo_root repo_path package exit_code=0
	_pkg_require_key || return 1
	_pkg_get_params || return 2
	msg 'Signing all package files...'
	while IFS= read -r -d '' package; do
		_pkg_sign_file "$package" || exit_code=4
	done < <(find "$repo_root" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' -print0)
	(( exit_code == 0 )) || return "$exit_code"
	msg 'Signing all database files...'
	_pkg_sign_databases
}

usage() {
	cat <<'HELP'
Usage: packages COMMAND [ARGUMENTS]

Commands:
  update [aur]         Update official packages; optionally update AUR first
  aur [OPTIONS]        Run aur sync with the existing trusted-build defaults
  add FILE...          Sign and add package files to the local repository
  remove NAME...       Remove packages and their files; sign the database
  verify               Report repository packages not installed locally
  sign-db              Replace database signatures
  sign-all             Replace package and database signatures
  help                 Show this help

Examples:
  packages update
  packages update aur
  packages aur -u
  packages add ./example-1.0-1-x86_64.pkg.tar.zst
  packages remove example
  packages verify
  packages sign-db

Repository parameters come from `aur repo`; signing uses GPGKEY.
The aur command preserves --noview --chroot --sign --remove.
HELP
}

main() {
	local action=${1:-help}
	(( $# == 0 )) || shift
	case $action in
		help|-h|--help) usage ;;
		update)
			if (( $# > 1 )) || [[ ${1:-aur} != aur ]]; then
				error 'Usage: packages update [aur]'
				return 2
			fi
			update "$@"
			;;
		aur) aursync "$@" ;;
		add) pkgadd "$@" ;;
		remove) pkgdel "$@" ;;
		verify|sign-db|sign-all)
			if (( $# != 0 )); then
				error "Unexpected arguments for ${action}"
				return 2
			fi
			case $action in
				verify) pkgverify ;;
				sign-db) localdbsign ;;
				sign-all) fixlocaldb ;;
			esac
			;;
		*) error "Unknown command: ${action}"; usage >&2; return 2 ;;
	esac
}
main "$@"
