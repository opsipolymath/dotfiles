#!/usr/bin/env bash
# Polybar WireGuard indicator.
# Called by: polybar module/wireguard (exec, interval = 5)
# Prints a space when any WireGuard interface exists, so the module shows its
# format-prefix icon; prints an empty line otherwise, which hides the module.

for path in /sys/class/net/*; do
	if grep -qsx 'DEVTYPE=wireguard' "${path}/uevent"; then
		printf ' \n'
		exit 0
	fi
done

printf '\n'
