#!/usr/bin/env bash
# Polybar media module: --icon (print once) or --text (continuous ticker).
# Spotify via MPRIS; MPD via mpc, no MPD MPRIS bridge needed.
# Usage: scroll_media_status [--icon|--text]
# Called by: polybar (--icon with interval = 2; --text as a tailed module)
# Requires: playerctl, mpc 0.34 or later (either may be absent)

mode=${1:---text}
width=30
scroll_gap='   '
frame_delay=0.5

format_time() {
	local seconds=$1
	if (( seconds >= 3600 )); then
		printf '%d:%02d:%02d' "$((seconds / 3600))" "$((seconds / 60 % 60))" "$((seconds % 60))"
		return
	fi
	printf '%d:%02d' "$((seconds / 60))" "$((seconds % 60))"
}

# Convert M:SS or H:MM:SS to seconds; print 0 for anything else.
to_seconds() {
	local value=$1 hours=0 minutes seconds
	if [[ ! ${value} =~ ^([0-9]{1,6}):([0-9]{2})(:([0-9]{2}))?$ ]]; then
		printf '0'
		return
	fi
	minutes=${BASH_REMATCH[1]}
	seconds=${BASH_REMATCH[2]}
	if [[ -n ${BASH_REMATCH[3]} ]]; then
		hours=${minutes}
		minutes=${seconds}
		seconds=${BASH_REMATCH[4]}
	fi
	printf '%d' "$((10#${hours} * 3600 + 10#${minutes} * 60 + 10#${seconds}))"
}

get_spotify() {
	local player status metadata artist song time_text
	command -v playerctl >/dev/null 2>&1 || return 1
	while IFS= read -r player; do
		# Spotify's MPRIS name is spotify, or spotify.instanceN for extra instances.
		[[ ${player} == spotify || ${player} == spotify.* ]] || continue
		status=$(playerctl --player="${player}" status 2>/dev/null) || continue
		[[ ${status} == Playing ]] || continue
		player_source=spotify
		if [[ ${mode} == --icon ]]; then
			return 0
		fi
		# Spotify is known to be playing even if its metadata query fails;
		# refresh's placeholders are shown in that case.
		metadata=$(playerctl --player="${player}" metadata \
			--format $'{{ artist }}\x1f{{ title }}\x1f{{ duration(mpris:length - position) }}' \
			2>/dev/null) || return 0
		metadata=${metadata//$'\n'/ }
		IFS=$'\x1f' read -r artist song time_text <<< "${metadata}"
		title="${artist:-Unknown artist} - ${song:-Unknown title}"
		remaining=${time_text:-?:??}
		return 0
	done < <(playerctl --list-all 2>/dev/null)
	return 1
}

get_mpd() {
	local status state metadata artist song elapsed duration elapsed_seconds duration_seconds
	command -v mpc >/dev/null 2>&1 || return 1
	# Formatted fields avoid parsing mpc's human-readable status display.
	status=$(mpc status $'%state%\x1f%currenttime%\x1f%totaltime%' 2>/dev/null) || return 1
	IFS=$'\x1f' read -r state elapsed duration <<< "${status}"
	[[ ${state} == playing ]] || return 1
	player_source=mpd
	if [[ ${mode} == --icon ]]; then
		return 0
	fi

	elapsed_seconds=$(to_seconds "${elapsed}")
	duration_seconds=$(to_seconds "${duration}")
	if (( duration_seconds > 0 )); then
		remaining=$(format_time "$((duration_seconds > elapsed_seconds ? duration_seconds - elapsed_seconds : 0))")
	fi
	metadata=$(mpc current --format $'%artist%\x1f%title%' 2>/dev/null) || return 0
	metadata=${metadata//$'\n'/ }
	IFS=$'\x1f' read -r artist song <<< "${metadata}"
	title="${artist:-Unknown artist} - ${song:-Unknown title}"
	return 0
}

# Sets the globals player_source (spotify, mpd or idle), title and remaining.
# The placeholders remain when a player is playing but its metadata fails.
refresh() {
	player_source=idle
	title='Metadata unavailable'
	remaining='?:??'
	get_spotify || get_mpd || :
}

# Print one ticker frame and advance the global offset.
render_text() {
	local full_text loop
	display='No music is currently playing'
	if [[ ${player_source} != idle ]]; then
		# Control characters in tags would corrupt Polybar's line-based input.
		full_text="${title} [${remaining}]"
		full_text=${full_text//[[:cntrl:]]/ }
		display=${full_text}
		if (( ${#full_text} > width )); then
			loop=${full_text}${scroll_gap}
			offset=$((offset % ${#loop}))
			display=${loop:offset:width}
			if (( ${#display} < width )); then
				display+=${loop:0:width-${#display}}
			fi
			offset=$(( (offset + 1) % ${#loop} ))
		fi
	fi
	# Polybar would parse %{ in a title as a formatting tag, including one formed
	# where the scrolling text wraps; a fullwidth percent sign looks the same.
	display=${display//'%{'/'％{'}
	# Pad by characters; printf's %-*.*s counts bytes and would cut
	# multibyte characters in half.
	printf '%s%*s\n' "${display}" "$((width - ${#display}))" ''
}

usage() {
	printf 'Usage: %s [--icon|--text]\n' "${0##*/}"
}

if (( $# > 1 )); then
	usage >&2
	exit 2
fi
case ${mode} in
	--icon)
		refresh
		case ${player_source} in
			spotify) printf '󰓇\n' ;;
			mpd) printf '󰐹\n' ;;
			*) printf '󰽳\n' ;;
		esac
		;;
	--text)
		old_track=''
		offset=0
		frame=0
		while :; do
			# Query the players every other frame; scroll on every frame.
			if (( frame % 2 == 0 )); then
				refresh
				track_id="${player_source}:${title}"
				if [[ ${track_id} != "${old_track}" ]]; then
					offset=0
					old_track=${track_id}
				fi
			fi
			render_text
			frame=$(( (frame + 1) % 2 ))
			sleep "${frame_delay}" || exit $?
		done
		;;
	-h|--help) usage ;;
	*)
		usage >&2
		exit 2
		;;
esac
