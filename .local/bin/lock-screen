#!/usr/bin/env bash
# Lock the screen with i3lock, showing the blurred, dimmed wallpaper.
# Called by: xss-lock (bspwmrc), on loginctl lock-session, idle and suspend
# Requires: i3lock or i3lock-color; optionally dunstctl
#
# set-wallpaper renders the lock image. Without one, the background is Nord
# blue (#5e81ac).
# i3lock-color adds a Nord indicator and clock; plain i3lock rejects those
# options, and a locker that fails to start leaves the screen unlocked, so
# they are used only with i3lock-color.
#
# With xss-lock --transfer-sleep-lock, a suspend waits until the inherited
# sleep-lock descriptor is closed. i3lock in fork mode returns only once the
# screen is locked, so the descriptor is closed after that. Based on
# /usr/share/doc/xss-lock/transfer-sleep-lock-i3lock.sh.

lock_image=${XDG_CACHE_HOME:-${HOME}/.cache}/lock-screen/lock.png

if ! command -v i3lock >/dev/null 2>&1; then
	printf 'ERROR: Required command is not installed: i3lock\n' >&2
	exit 1
fi

# Options both versions accept: ignore an empty Enter.
i3lock_options=(--ignore-empty-password)
if [[ -r ${lock_image} ]]; then
	i3lock_options+=(--image="${lock_image}")
fi

# i3lock-color reports versions such as 2.13.c.5, and takes rrggbbaa colours.
# Keypresses are dark grey, verifying green and failures red; plain i3lock's
# indicator colours are fixed, so only its background can follow. The status
# texts are blank, so only the colours show; --force-clock keeps the clock up
# meanwhile. A failure to lock still says so, and Caps Lock is still shown.
if [[ $(i3lock --version 2>&1) == *.c.* ]]; then
	font='JetBrains Mono Nerd Font'
	i3lock_options+=(
		--color=5e81acff
		--indicator --force-clock --time-str=%H:%M --date-str='%d %b %Y'
		--time-font="${font}" --date-font="${font}"
		--verif-font="${font}" --wrong-font="${font}"
		--inside-color=2e344099 --ring-color=88c0d0ff --separator-color=00000000
		--insidever-color=2e344099 --ringver-color=a3be8cff
		--insidewrong-color=2e344099 --ringwrong-color=bf616aff
		--keyhl-color=2e3440ff --bshl-color=bf616aff --line-uses-inside
		--time-color=eceff4ff --date-color=eceff4ff
		--verif-color=a3be8cff --wrong-color=bf616aff
		--verif-text= --wrong-text= --noinput-text= --lock-text=
	)
else
	i3lock_options+=(--color=5e81ac --show-failed-attempts)
fi

# Hide notifications while locked: they would otherwise draw over i3lock.
# Notifications already paused before locking stay paused after unlocking.
notifications_were_paused=true
pause_notifications() {
	command -v dunstctl >/dev/null 2>&1 || return 0
	notifications_were_paused=$(dunstctl is-paused 2>/dev/null) || notifications_were_paused=true
	dunstctl set-paused true
}
resume_notifications() {
	if [[ ${notifications_were_paused} == false ]]; then
		dunstctl set-paused false
	fi
}

# Keep Ctrl+Alt+Fn from reaching the consoles while X is locked. physlock -l
# and -L only switch VT switching off and on, through the sudo rule in
# /etc/sudoers.d/physlock. Without them the screen still locks, with the
# consoles reachable, so warn rather than fail.
#
# When X locks while a console is on screen, switching stays enabled, or that
# console would be trapped in front; console-lock guards it instead. It is
# disabled as soon as X's VT comes back, while i3lock still holds the screen.
vt_switching=open # open, locked, or failed
lock_vt_switching() {
	[[ ${vt_switching} == open ]] || return 0
	command -v physlock >/dev/null 2>&1 || return 0
	if sudo -n /usr/bin/physlock -l; then
		vt_switching=locked
	else
		vt_switching=failed
		printf 'WARNING: Could not disable VT switching; the consoles stay reachable\n' >&2
	fi
}
# shellcheck disable=SC2329 # invoked by the EXIT trap
unlock_vt_switching() {
	if [[ ${vt_switching} == locked ]]; then
		sudo -n /usr/bin/physlock -L
	fi
}
# True while X's VT is on screen. X runs on the login VT (see xserverrc); if
# that is unknown, assume X is in front.
x_vt_active() {
	local active_tty
	[[ ${XDG_VTNR:-} == [0-9]* ]] || return 0
	read -r active_tty </sys/class/tty/tty0/active || return 0
	[[ ${active_tty} == "tty${XDG_VTNR}" ]]
}
guard_vt_switching() {
	if x_vt_active; then
		lock_vt_switching
	fi
}

pause_notifications
guard_vt_switching
# Every exit from here re-enables VT switching, including after X dies (HUP).
trap unlock_vt_switching EXIT
trap 'pkill -xu "${EUID}" i3lock' TERM INT HUP

if [[ -e /dev/fd/${XSS_SLEEP_LOCK_FD:--1} ]]; then
	# Locking for a suspend: i3lock forks once the screen is locked, without a
	# copy of the descriptor; closing ours then lets the system sleep.
	i3lock "${i3lock_options[@]}" {XSS_SLEEP_LOCK_FD}<&-
	status=$?
	exec {XSS_SLEEP_LOCK_FD}<&-
	if (( status != 0 )); then
		resume_notifications
		printf 'ERROR: i3lock failed to lock the screen (status %s)\n' "${status}" >&2
		exit "${status}"
	fi
	while pkill -0 -xu "${EUID}" i3lock; do
		guard_vt_switching
		sleep 0.5
	done
	resume_notifications
	exit 0
fi

i3lock --nofork "${i3lock_options[@]}" &
locker_pid=$!
while kill -0 "${locker_pid}" 2>/dev/null; do
	guard_vt_switching
	sleep 0.5
done
wait "${locker_pid}"
status=$?
resume_notifications
exit "${status}"
