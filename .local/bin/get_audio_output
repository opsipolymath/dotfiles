#!/usr/bin/env bash

# Display headphones or speakers based on the default audio sink.

headphones='󰋎'
speakers='󱌈'

# Identify the default sink.
sink=$(pactl get-default-sink 2>/dev/null) || exit 0

# USB DAC or Bluetooth output.
if [[ $sink == *Schiit* || $sink == bluez_sink* ]]; then
    printf '%%{R} %s \n' "$headphones"
    exit 0
fi

# Determine the active port of the default sink.
port=$(
    pactl list sinks 2>/dev/null |
    awk -v sink="$sink" '
        /^[[:space:]]*Name:/ {
            active = ($2 == sink)
        }
        active && /^[[:space:]]*Active Port:/ {
            print $3
            exit
        }
    '
)

# Select icon.
case "$port" in
    *headphones* | *headset*)
        icon=$headphones
        ;;
    *)
        icon=$speakers
        ;;
esac

printf '%%{R} %s \n' "$icon"
