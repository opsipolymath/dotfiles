#!/usr/bin/env bash
# Schedule, list, cancel, and play alarms using at queue z.
# Usage: alarm COMMAND [ARGUMENTS]   (see: alarm help)
# Requires: at (with atd running), mpg123
# Scheduled jobs call this executable's play command, so it must stay at the
# same path while alarms are pending.
error() {
	printf 'ERROR: %s\n' "$*" >&2
}
msg() {
	printf '%s\n' "$*"
}

_alarm_require() {
	local dependency
	for dependency in "$@"; do
		if ! command -v "${dependency}" >/dev/null 2>&1; then
			error "Required command is not installed: ${dependency}"
			return 1
		fi
	done
}

_alarm_jobs() {
	_alarm_require atq || return 1
	# The C locale keeps atq's English date format, which the parsers below expect.
	LC_ALL=C command atq -q z
}

_alarm_list() {
	local queue job_number job_details weekday month day alarm_time year
	queue=$(_alarm_jobs) || return 1
	while IFS=$'\t' read -r job_number job_details; do
		[[ -n ${job_number} ]] || continue
		# atq prints: Mon Nov  2 07:30:00 2026 z user
		read -r weekday month day alarm_time year _ <<< "${job_details}"
		msg "Alarm ${job_number} at ${alarm_time:0:5} on ${weekday} ${month} ${day} ${year}"
	done <<< "${queue}"
}

_alarm_cancel() {
	local target=${1:-all} queue job_number job_details alarm_time selected='' count=0
	queue=$(_alarm_jobs) || return 1
	if [[ ${target} == all ]]; then
		while IFS=$'\t' read -r job_number _; do
			[[ -n ${job_number} ]] || continue
			command atrm "${job_number}" || return 1
			msg "Alarm ${job_number} cancelled"
		done <<< "${queue}"
		return 0
	fi
	while IFS=$'\t' read -r job_number job_details; do
		[[ -n ${job_number} ]] || continue
		read -r _ _ _ alarm_time _ <<< "${job_details}"
		if [[ ${target} == "${job_number}" || ${target} == "${alarm_time:0:5}" ]]; then
			selected=${job_number}
			count=$((count + 1))
		fi
	done <<< "${queue}"
	if (( count != 1 )); then
		error "Expected one matching alarm; found ${count}"
		return 1
	fi
	command atrm "${selected}" || return 1
	msg "Alarm ${selected} cancelled"
}

_alarm_set() {
	local alarm_file alarm_link alarm_time
	if (( $# < 1 || $# > 2 )) || [[ ! $1 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
		error 'Usage: alarm set HH:MM [file]'
		return 2
	fi
	alarm_time=$1
	alarm_file=${2:-${XDG_DATA_HOME:-${HOME}/.local/share}/.alarm.mp3}
	if [[ ! -f ${alarm_file} || ! -r ${alarm_file} ]]; then
		error "Alarm file is not readable: ${alarm_file}"
		return 1
	fi
	_alarm_require at mpg123 pgrep || return 1
	# at queues jobs even when atd is stopped, and such an alarm would never play.
	if ! pgrep -x atd >/dev/null 2>&1; then
		error 'atd is not running, so no alarm was set. Start it, and enable it at boot, with:'
		printf '  sudo systemctl enable --now atd\n' >&2
		return 1
	fi
	alarm_file=$(realpath -- "${alarm_file}") || return 1
	alarm_link=$(realpath -- "${BASH_SOURCE[0]}") || return 1
	# at executes /bin/sh. Single-quote arguments, including embedded apostrophes.
	alarm_file=${alarm_file//\'/\'\\\'\'}
	alarm_link=${alarm_link//\'/\'\\\'\'}
	if ! printf "'%s' play '%s'\n" "${alarm_link}" "${alarm_file}" | command at -q z "${alarm_time}"; then
		error 'Unable to set alarm (is atd running?)'
		return 1
	fi
	msg 'Alarm set'
}

usage() {
	cat <<'HELP'
Usage: alarm COMMAND [ARGUMENTS]

Commands:
  set HH:MM [FILE]          Schedule playback (next occurrence of that time)
  list                      List alarms in at queue z
  cancel [all|JOB|HH:MM]    Cancel all alarms or one matching job/time
  play FILE                 Play a file; also used by scheduled jobs
  stop                      Stop playback launched through this command
  help                      Show this help

Examples:
  alarm set 07:30
  alarm set 12:00 "$HOME/Music/alarm.mp3"
  alarm list
  alarm cancel 12:00
  alarm cancel all
  alarm stop

The default file is ${XDG_DATA_HOME:-$HOME/.local/share}/.alarm.mp3.
Queue z is reserved for alarms. Scheduled jobs need this executable to remain
at the same path. Playback is named ygg-alarm so stop does not kill other audio.
HELP
}

main() {
	local action=${1:-help} result
	(( $# == 0 )) || shift
	case ${action} in
		help|-h|--help) usage ;;
		set) _alarm_set "$@" ;;
		list)
			(( $# == 0 )) || { error 'Usage: alarm list'; return 2; }
			_alarm_list
			;;
		cancel)
			(( $# <= 1 )) || { error 'Usage: alarm cancel [all|JOB|HH:MM]'; return 2; }
			_alarm_cancel "${1:-all}"
			;;
		play)
			(( $# == 1 )) || { error 'Usage: alarm play FILE'; return 2; }
			# Keep an identifiable process name without creating an alarm symlink.
			exec -a ygg-alarm mpg123 -- "$1"
			;;
		stop)
			(( $# == 0 )) || { error 'Usage: alarm stop'; return 2; }
			pkill -u "$(id -u)" -f '^ygg-alarm( |$)'
			result=$?
			# pkill exits 1 when nothing matched and 2 or 3 on a real error.
			if (( result == 1 )); then
				msg 'No alarm is playing'
				return 0
			fi
			if (( result != 0 )); then
				error 'Unable to stop alarm playback'
				return "${result}"
			fi
			;;
		*) error "Unknown command: ${action}"; usage >&2; return 2 ;;
	esac
}
main "$@"
