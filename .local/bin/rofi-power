#!/usr/bin/env bash
# Power menu in rofi: lock, log out of bspwm, reboot, or power off.
# Called by: sxhkd (super + q)
# Requires: rofi, bspc, loginctl, systemctl, rofi-confirmation
lock_icon='󰍁'
exit_icon=''
reboot_icon='󰦛'
poweroff_icon='󰐥'

# Uptime is informational; show the menu even if it cannot be read.
uptime_text=$(uptime -p 2>/dev/null) || uptime_text='unknown'

# -no-custom accepts only the listed icons; dismissing rofi exits non-zero.
selected=$(printf '%s\n' "${lock_icon}" "${exit_icon}" "${reboot_icon}" "${poweroff_icon}" |
	rofi -theme-str 'textbox-prompt {str: "󰐥";}' \
		-dmenu \
		-no-custom \
		-p "${HOSTNAME:-Power}" \
		-mesg "Uptime: ${uptime_text#up }" \
		-theme applet) || exit 0

case ${selected} in
	"${lock_icon}") exec loginctl lock-session ;;
	"${exit_icon}") exec bspc quit ;;
	"${reboot_icon}")
		if rofi-confirmation 'Really reboot?'; then
			exec systemctl reboot
		fi
		;;
	"${poweroff_icon}")
		if rofi-confirmation 'Really shut down?'; then
			exec systemctl poweroff
		fi
		;;
	*) ;;
esac
