// Custom menu theme for rofi: a searchable vertical list.
// Shared settings are in common.rasi; only the differences are set here.

@import "common.rasi"

inputbar {
	orientation: vertical;
	spacing: 275px;
	background-image: url("images/menu.png", width);
	children: [ "prompt-holder", "entry" ];
}

prompt-holder {
	enabled: true;
	orientation: horizontal;
	spacing: 25px;
	padding: 25px;
	background-color: transparent;
	text-color: @foreground;
	children: [ "textbox-prompt", "prompt"];
}

textbox-prompt {
	padding: 10px 10px 13px;
}

entry {
	enabled: true;
	orientation: horizontal;
	padding: 5px 15px 5px 10px;
	margin: 25px;
	background-color: @background-light;
	text-color: inherit;
	cursor: text;
	placeholder: "Search";
	placeholder-color: inherit;
	vertical-align: 0.5;
}

listview {
	columns: 1;
	lines: 15;
	spacing: 0px;
}

element {
	padding: 5px 5px;
	border: 0px;
}
