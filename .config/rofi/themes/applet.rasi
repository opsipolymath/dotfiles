// Custom applet theme for rofi: a row of large icon buttons.
// Shared settings are in common.rasi; only the differences are set here.

@import "common.rasi"

inputbar {
	spacing: 25px;
	padding: 25px 25px 325px;
	background-image: url("images/applet.png", width);
	children: [ "textbox-prompt", "prompt"];
}

textbox-prompt {
	padding: 10px 13px;
}

listview {
	columns: 4;
	lines: 1;
	spacing: 20px;
}

element {
	padding: 30px 10px;
	border: 1px solid;
	border-radius: 0px;
	border-color: @selected;
}
element-text {
	font: "JetBrains Mono Nerd Font 28";
	horizontal-align: 0.5;
}
