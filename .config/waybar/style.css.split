* {
	font-family: "JetBrainsMono Nerd Font Propo";
	font-size: 14px;
}

window#waybar {
	border: 0;
	background: transparent;
}

window > box {
	background: transparent;
	transition-duration: .5s;
	border: 0;
}

button {
	
	box-shadow: inset 0 -3px transparent;
	
	border: none;
	border-radius: 0;
}

#workspaces {
	border: 2px solid #88C0D0;
	border-radius: 25px;
	color: #88C0D0;
	padding: 0;
	margin: 0;
	background: rgba(46, 52, 64, 1.0);
}

#workspaces button {
	margin: 0;
	padding: 2px;
	color: #88C0D0;
}

#workspaces button label {
	margin: 3px 0 0 0;
	padding: 2px 4px 0 4px;
}

#workspaces button.active {
	background: #88C0D0;
	color: #2E3440;
}

#workspaces button:first-child {
	border-radius: 25px 0 0 25px;
	padding-left: 5px;
}

#workspaces button:last-child {
	border-radius: 0 25px 25px 0;
	padding-right: 5px;
}

#workspaces button.empty {
	color: #4C566A;
}

#workspaces button.urgent {
	background: #BF616A;
}

#custom-spotify.icon {
	font-size: 18px;
	color: #A3BE8C;
	padding-left: 12px;
	border-left: 2px solid #88C0D0;
	border-radius: 25px 0 0 25px;
}

#custom-spotify {
	padding: 0px 10px 0 5px;
	color: #88C0D0;
	background: rgba(46, 52, 64, 1.0);
	border-top: 2px solid #88C0D0;
	border-bottom: 2px solid #88C0D0;
}

#custom-spotify.time {
	padding: 0px 12px 0 5px;
	border-right: 2px solid #88C0D0;
	border-radius: 0 25px 25px 0;
}

.modules-right {
	border: 2px solid #88C0D0;
	border-radius: 25px;
	margin: 0;
	padding: 0;
}

#network,
#pulseaudio,
#temperature,
#backlight,
#battery,
#clock,
#privacy,
#tray,
#scratchpad {
	margin: 0;
	padding: 0 10px;
	color: #88C0D0;
	background: rgba(46, 52, 64, 1.0);
}

#network.icon,
#pulseaudio.icon,
#pulseaudio.source,
#temperature.icon,
#backlight.icon,
#battery.icon,
#clock.icon,
#privacy.icon,
#tray.icon,
#scratchpad.icon {
	border-radius: 0;
	background: #81A1C1;
	color: #2E3440;
}

#network:hover,
#pulseaudio:hover,
#temperature:hover,
#backlight:hover,
#battery:hover,
#clock:hover,
#tray:hover,
#privacy:hover,
#scratchpad:hover {
	background: #D8DEE9;
}

#network.icon {
	border-radius: 25px 0 0 25px;
}

@import "status.css";

#tray {
	background: #5E81AC;
	border-radius: 0 25px 25px 0;
}

#tray > .passive {
	-gtk-icon-effect: dim;
}

#tray > .needs-attention {
	-gtk-icon-effect: highlight;
	background: #BF616A;
}

#workspaces button:hover,
#network:hover,
#pulseaudio:hover,
#temperature:hover,
#backlight:hover,
#battery:hover,
#clock:hover,
#tray:hover,
#privacy:hover,
#scratchpad:hover {
	background: #D8DEE9;
	color: #2E3440;
}
