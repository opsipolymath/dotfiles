# shellcheck shell=bash
# Small interactive functions that benefit from the current shell environment.

# Git wrapper for the bare dotfiles repository; DOTFILES is set in shellenv.
dotfiles() {
	command git --git-dir="${DOTFILES:-${XDG_CONFIG_HOME:-${HOME}/.config}/dotfiles}" --work-tree="${HOME}" "$@"
}

# Refresh the active YubiKey explicitly instead of probing hardware at startup.
yku() {
	command gpg-connect-agent 'scd serialno' 'learn --force' /bye
}

# With no arguments (or just "a"), attach to an existing session or start one;
# do nothing when already inside tmux. Anything else goes straight to tmux.
tmux() {
	if (( $# > 1 )) || [[ $# -eq 1 && $1 != a ]]; then
		command tmux "$@"
		return
	fi
	[[ -z ${TMUX:-} ]] || return 0
	if command tmux has-session 2>/dev/null; then
		command tmux attach-session
		return
	fi
	command tmux new-session
}

# Overwrite the previous X startup log in the state directory; preserve arguments.
# Once X has started, the console logs out when X exits or is killed, instead of
# leaving a shell open behind the X lock screen. If X fails to start, the shell
# stays, with an error. xinitrc creates the file named in STARTX_STARTED_FILE,
# which tells the two apart. Until then, the shell ignores Ctrl+C and Ctrl+\, so
# nothing typed when X dies can interrupt the logout (interactive shells ignore
# Ctrl+Z already). From any other shell (a nested shell, tmux), the login shell
# would survive X, so refuse; "command startx" still starts X there, without
# that protection.
startx() {
	local log_dir="${XDG_STATE_HOME:-${HOME}/.local/state}"
	local login_shell=false console started_file
	if [[ -n ${BASH_VERSION:-} ]]; then
		shopt -q login_shell && login_shell=true
	elif [[ -o login ]]; then
		login_shell=true
	fi
	console=$(tty)
	if [[ ${login_shell} != true || -n ${TMUX:-} || ${console} != /dev/tty[0-9]* ]]; then
		error 'startx: run it from the login shell on a console'
		return 1
	fi
	if [[ ! -x /usr/bin/startx ]]; then
		error 'startx: /usr/bin/startx is not installed'
		return 1
	fi
	command mkdir -p -- "${log_dir}" || return 1
	started_file="${XDG_RUNTIME_DIR:-${log_dir}}/startx-${console#/dev/}.started"
	command rm -f -- "${started_file:?}"

	trap '' INT QUIT
	STARTX_STARTED_FILE=${started_file} /usr/bin/startx "$@" >"${log_dir}/startx.log" 2>&1
	if [[ -e ${started_file} ]]; then
		command rm -f -- "${started_file:?}"
		# exit refuses while jobs are stopped, and the shell must not outlive X.
		# zsh refuses only with check_jobs, and leaves the function when it does;
		# Bash refuses regardless, and carries on to the kill.
		if [[ -n ${ZSH_VERSION:-} ]]; then
			unsetopt check_jobs
		fi
		exit
		# shellcheck disable=SC2317 # reached when Bash's exit refuses
		kill -KILL "$$"
	fi
	trap - INT QUIT
	error "startx: X didn't start; see ${log_dir}/startx.log"
	return 1
}

# Start Claude in its project directory without changing the caller's directory.
claude() (
	local project_dir="${HOME}/Projects/claude"
	command mkdir -p -- "${project_dir}" || return 1
	cd -- "${project_dir}" && exec /usr/bin/claude "$@"
)

# True when this shell runs on the far end of an SSH connection. Either variable
# counts: tmux refreshes SSH_CONNECTION for new panes on attach, while SSH_TTY
# survives in panes of a tmux server first started over SSH. Used by the prompts
# and shell_shutdown, so a false positive only costs an extra warning.
shell_is_ssh() {
	[[ -n ${SSH_CONNECTION:-}${SSH_TTY:-} ]]
}

# Confirm remote shutdowns; preserve arguments and command exit status.
shell_shutdown() {
	local action=$1
	shift
	if ! shell_is_ssh; then
		"/usr/bin/${action}" "$@"
		return $?
	fi
	warning 'Connected via SSH'
	if ! shell_confirm "Really ${action}? "; then
		msg2 'Cancelling'
		return 0
	fi
	command sudo "/usr/bin/${action}" "$@"
}
poweroff() {
	shell_shutdown poweroff "$@"
}
reboot() {
	shell_shutdown reboot "$@"
}
