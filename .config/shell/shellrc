# shellcheck shell=bash
# Interactive settings shared by Bash and zsh; not a POSIX sh configuration.
[[ -n ${BASH_VERSION:-}${ZSH_VERSION:-} && $- == *i* ]] || return 0

# The entry points set SHELL_HOME relative to their own configuration directory.
export SHELL_HOME="${SHELL_HOME:-${XDG_CONFIG_HOME:-${HOME}/.config}/shell}"
# shellcheck source=shellenv
source "${SHELL_HOME}/shellenv"

# Add script locations once, preferring the explicitly staged command directory.
for shell_bin in "${HOME}/.local/bin" "${HOME}/bin"; do
	case :${PATH}: in
		*:"$shell_bin":*) ;;
		*) PATH="${shell_bin}:${PATH}" ;;
	esac
done
export PATH
unset shell_bin

if command -v xdg-user-dirs-update >/dev/null 2>&1; then
	xdg-user-dirs-update
fi
if [[ -r ${XDG_CONFIG_HOME}/user-dirs.dirs ]]; then
	# Generated by xdg-user-dirs, outside this configuration tree.
	# shellcheck source=/dev/null
	source "${XDG_CONFIG_HOME}/user-dirs.dirs"
fi
if [[ -t 1 && ${TERM:-dumb} != dumb ]] && command -v tabs >/dev/null 2>&1; then
	tabs -4
fi

# Each shell owns its history format. Keep history outside the config tree.
shell_prepare_history() (
	umask 077
	mkdir -p -- "${XDG_STATE_HOME}/shell" && touch -- "$HISTFILE"
)
HISTSIZE=200000

# shellcheck source=messages
source "${SHELL_HOME}/messages"
# Select the native GnuPG SSH agent; SSH config refreshes its terminal on demand.
if command -v gpgconf >/dev/null 2>&1; then
	if SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket); then
		export SSH_AUTH_SOCK
	fi
fi
if [[ -t 0 ]]; then
	GPG_TTY=$(tty)
	export GPG_TTY
fi

if [[ -n ${BASH_VERSION:-} ]]; then
	export BDOTDIR="${BDOTDIR:-${SHELL_HOME}/bash}"
	HISTFILE="${XDG_STATE_HOME}/shell/bash_history"
	shell_prepare_history || return 1
	# shellcheck source=bash/bashrc
	source "${BDOTDIR}/bashrc"
else
	export ZDOTDIR="${ZDOTDIR:-${SHELL_HOME}/zsh}"
	HISTFILE="${XDG_STATE_HOME}/shell/zsh_history"
	shell_prepare_history || return 1
	# ShellCheck cannot parse zsh configuration; it is checked with zsh -n.
	# shellcheck source=/dev/null
	source "${ZDOTDIR}/zshrc"
fi

# Load functions before aliases so aliases cannot rewrite function definitions.
# shellcheck source=functions
source "${SHELL_HOME}/functions"
# shellcheck source=poweroff
source "${SHELL_HOME}/poweroff"
# WSL bridge remains available pending a test of Windows-backed Git signing.
# shellcheck source=wsl
source "${SHELL_HOME}/wsl"
# shellcheck source=aliases
source "${SHELL_HOME}/aliases"
