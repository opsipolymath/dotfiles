# Keybindings for consoles/ssh

# Load the modules for searching and completions
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zmodload zsh/complist

# Create widgets to enable searching with arrow keys
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

# Standard console
bindkey "\e[A"  up-line-or-beginning-search
bindkey "\e[B"  down-line-or-beginning-search
bindkey "\e[1~" beginning-of-line
bindkey "\e[H"  beginning-of-line
bindkey "\e[4~" end-of-line
bindkey "\e[F"  end-of-line
bindkey "\e[5~" history-beginning-search-backward
bindkey "\e[6~" history-beginning-search-forward

# Bind optional terminal capabilities only when the terminal defines them.
zmodload zsh/terminfo
_shell_bind_terminal_keys() {
	local capability widget
	for capability widget in \
		kcuu1 up-line-or-beginning-search \
		kcud1 down-line-or-beginning-search \
		khome beginning-of-line kend end-of-line kdch1 delete-char \
		kpp history-beginning-search-backward knp history-beginning-search-forward; do
		[[ -n ${terminfo[$capability]:-} ]] && bindkey "${terminfo[$capability]}" "$widget"
	done
}
_shell_bind_terminal_keys
unfunction _shell_bind_terminal_keys

# Fix delete key
bindkey "\e[3~" delete-char
bindkey "^[[P"  delete-char

# Allow vim keys in completion menus
bindkey -M menuselect 'h' vi-backward-char
bindkey -M menuselect 'k' vi-up-line-or-history
bindkey -M menuselect 'j' vi-down-line-or-history
bindkey -M menuselect 'l' vi-forward-char
