#!/usr/bin/env zsh
# Source from Zsh initialization; do not execute as a standalone script.

autoload -Uz add-zsh-hook

# Prompt escapes are native to Zsh and count as zero-width characters.
typeset -g PROMPT_SPLIT='%F{blue}]─['

prompt_git_changes() {
	local ahead behind changes
	local -a git_command=("$@")

	ahead="$("${git_command[@]}" rev-list --count '@{u}..HEAD' 2>/dev/null)"
	behind="$("${git_command[@]}" rev-list --count 'HEAD..@{u}' 2>/dev/null)"
	[[ $ahead == <-> ]] || ahead=0
	[[ $behind == <-> ]] || behind=0

	if (( ahead || behind )); then
		print -rn -- "${PROMPT_SPLIT}"
		(( ahead )) && print -rn -- "%F{green}${ahead}"
		(( behind )) && print -rn -- "%F{red}${behind}"
	fi

	changes="$("${git_command[@]}" status --porcelain=v1 2>/dev/null)"
	if [[ -n $changes ]]; then
		print -rn -- "${PROMPT_SPLIT}%F{red}dirty"
	else
		print -rn -- "${PROMPT_SPLIT}%F{green}clean"
	fi
}

prompt_git() {
	if command git rev-parse --is-inside-work-tree &>/dev/null; then
		prompt_git_changes git
	else
		case ${PWD}/ in
			"${HOME}/"|"${HOME}/.config/"*|"${HOME}/.cache/"*|"${HOME}/.local/"*)
				print -rn -- "${PROMPT_SPLIT}%F{yellow}dotfiles"
				prompt_git_changes git --git-dir="${DOTFILES}" --work-tree="$HOME"
				;;
		esac
	fi
}

prompt_battery() {
	local battery=/sys/class/power_supply/BAT0
	local battery_status capacity color
	[[ -z ${SSH_TTY:-} ]] || return 0
	[[ -r ${battery}/status && -r ${battery}/capacity ]] || return 0

	IFS= read -r battery_status < "${battery}/status"
	IFS= read -r capacity < "${battery}/capacity"
	[[ $capacity == <-> ]] || return 0

	if (( capacity >= 100 )); then
		color=green
	elif (( capacity < 10 )); then
		color=red
	elif [[ $battery_status == Charging ]]; then
		color=yellow
	else
		color=red
	fi

	print -rn -- "%F{${color}}${capacity}%%${PROMPT_SPLIT}"
}

prompt_ssh_indicator() {
	[[ -n ${SSH_TTY:-} ]] || return 0
	print -rn -- ' | %F{1}b%F{214}i%F{3}f%F{2}r%F{4}ö%F{6}s%F{5}t%F{blue}'
}

prompt_update() {
	local directory_color user_part end_color host

	directory_color=green
	[[ -w $PWD ]] || directory_color=red

	if (( EUID == 0 )); then
		user_part='%F{red}odin%F{green}'
		end_color=red
	else
		user_part='%F{green}%n'
		end_color=blue
	fi

	host=$(hostname)

	PROMPT="%B%F{blue}┌[%F{${directory_color}}%~$(prompt_git)%F{blue}]%f%b"$'\n'
	PROMPT+="%B%F{blue}└[$(prompt_battery)${user_part}@${host}$(prompt_ssh_indicator)%F{blue}]%f %F{${end_color}}%# %f%b"
}

# Refresh when entering a prompt or switching ZLE keymaps.
prompt_redraw() {
	prompt_update
	zle reset-prompt
}
zle -N zle-line-init prompt_redraw
zle -N zle-keymap-select prompt_redraw
add-zsh-hook precmd prompt_update

PROMPT2='%F{yellow}»··%_%(4l..··)··%F{blue}> %f'
PROMPT3='Make a selection: '
