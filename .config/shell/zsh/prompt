# Source from Zsh initialization; do not execute as a standalone script.
# zshrc autoloads add-zsh-hook before sourcing this file.

# Prompt escapes are native to Zsh and count as zero-width characters.
typeset -g PROMPT_SPLIT='%F{blue}]─['

typeset -g PROMPT_RED='%F{red}' PROMPT_GREEN='%F{green}'
typeset -g PROMPT_YELLOW='%F{yellow}' PROMPT_PERCENT='%%'
source "${ZDOTDIR}/../prompt"

prompt_ssh_indicator() {
	shell_is_ssh || return 0
	print -rn -- ' | %F{1}b%F{214}i%F{3}f%F{2}r%F{4}ö%F{6}s%F{5}t%F{blue}'
}

prompt_update() {
	local directory_color user_part end_color host

	directory_color=green
	[[ -w ${PWD} ]] || directory_color=red

	if (( EUID == 0 )); then
		user_part='%F{red}odin%F{green}'
		end_color=red
	else
		user_part='%F{green}%n'
		end_color=blue
	fi

	# Render the full hostname with zsh's built-in prompt escape.
	host='%M'

	PROMPT="%B%F{blue}┌[%F{${directory_color}}%~$(prompt_git)%F{blue}]%f%b"$'\n'
	PROMPT+="%B%F{blue}└[$(prompt_battery)${user_part}@${host}$(prompt_ssh_indicator)%F{blue}]%f %F{${end_color}}%# %f%b"
}

# Refresh the display when switching ZLE keymaps; precmd computes prompt data.
prompt_redraw() {
	zle reset-prompt
}
zle -N zle-keymap-select prompt_redraw
add-zsh-hook precmd prompt_update

