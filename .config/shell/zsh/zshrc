# zsh options, history, ZLE, and prompt hooks.
setopt nomatch notify
unsetopt beep

# Keep the existing zsh directory-stack conveniences.
DIRSTACKSIZE=12
setopt autocd autopushd pushdsilent pushdtohome
bindkey -v
KEYTIMEOUT=10
bindkey '^L' clear-screen

SAVEHIST=200000
setopt appendhistory incappendhistory histignorealldups histignorespace
unsetopt sharehistory

shell_sync_history() {
	fc -RI "$HISTFILE"
}

shell_read_char() {
	IFS= read -r -k 1 "$1"
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd shell_sync_history

source "${ZDOTDIR}/completion"
source "${ZDOTDIR}/keybinds"
source "${ZDOTDIR}/prompt"
