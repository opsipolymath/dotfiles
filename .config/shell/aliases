# shellcheck shell=bash
# General aliases. Interactive functions are loaded before these aliases.

# Fix sudo so alias expansion works
alias sudo='/usr/bin/sudo '

# Fixes for applications that require arguments to respect XDG
# shellenv initializes XDG_CONFIG_HOME before aliases expand.
# shellcheck disable=SC2154
alias irssi='irssi --home="${XDG_CONFIG_HOME:-${HOME}/.config}/irssi"'

# Default options for commonly used commands
alias cd='cd -P'
alias cp='cp -v'
alias mv='mv -v'
alias acp='/usr/bin/advcp -g'
alias amv='/usr/bin/advmv -g'
alias df='/usr/bin/df -h'
alias du='/usr/bin/du -h'
alias grep='grep --color=auto'
alias ls='/usr/bin/ls --color=auto -hv --group-directories-first'
alias sort='/usr/bin/sort -h'

# Shortened aliases for common applications
alias docks='sudo docker ps --format "table {{.Names}}\t{{.Image}}\t{{.CreatedAt}}\t{{.Status}}\t{{.ID}}\t{{.Networks}}" | awk '\''NR==1 {print; next} {print | "sort -k1,1"}'\'''
alias docks_all='sudo docker ps -a --format "table {{.Names}}\t{{.Image}}\t{{.CreatedAt}}\t{{.Status}}\t{{.ID}}" | awk '\''NR==1 {print; next} {print | "sort -k1,1"}'\'''
alias em="emacsclient -c -a 'emacs'"
alias emacs="emacsclient -c -a 'emacs'"
alias info='/usr/bin/pinfo'
alias lc='/usr/bin/latexmk -aux-directory=/tmp/latex -pdf'
alias mkdiff='diff -U 99999'
alias ncmpcpp='music'
alias nd='/usr/bin/vim -d'
alias nv='/usr/bin/vim'
alias vi='/usr/bin/vim'
alias se='/usr/bin/sudoedit'
alias steam='/usr/bin/steam -nochatui -nofriendsui -silent'

alias git-notes='git --git-dir="/containers/50. code-server/git/"'

# Use SSH_CONFIG for scp.
if [[ -n ${SSH_CONFIG:-} ]]; then
	alias scp='/usr/bin/scp -F "${SSH_CONFIG}"'
fi

# The colorful SSH wrapper also honors SSH_CONFIG.
alias ssh='bifrost'

# Preserve familiar package/alarm names while implementation lives in executables.
alias update='packages update'
alias aursync='packages aur'
alias pkgadd='packages add'
alias pkgdel='packages remove'
alias pkgverify='packages verify'
alias localdbsign='packages sign-db'
alias fixlocaldb='packages sign-all'
alias setalarm='alarm set'
alias killalarm='alarm stop'
