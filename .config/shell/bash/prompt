# shellcheck shell=bash
# Source from Bash initialization; do not execute as a standalone script.

# Bash requires \[...\] around every nonprinting sequence in PS1.
PROMPT_RED='\[\e[31m\]'
PROMPT_GREEN='\[\e[32m\]'
PROMPT_YELLOW='\[\e[33m\]'
PROMPT_BLUE='\[\e[34m\]'
PROMPT_RESET='\[\e[0m\]'
PROMPT_SPLIT="${PROMPT_BLUE}]─["

PROMPT_PERCENT='%'
# shellcheck source=../prompt
source "${BDOTDIR:?}/../prompt"

# Seven colour stops, matching the Zsh SSH indicator.
prompt_ssh_indicator() {
	shell_is_ssh || return 0

	local character color index
	local -a characters=(b i f r ö s t)
	local -a colors=(31 '38;5;214' 33 32 34 36 35)

	printf ' | '
	for (( index = 0; index < ${#characters[@]}; index++ )); do
		color=${colors[index]}
		character=${characters[index]}
		printf '\\[\\e[%sm\\]%s' "${color}" "${character}"
	done
}

prompt_update() {
	local directory_color user_part end_color host

	directory_color=${PROMPT_GREEN}
	[[ -w ${PWD} ]] || directory_color=${PROMPT_RED}

	if (( EUID == 0 )); then
		user_part="${PROMPT_RED}odin${PROMPT_GREEN}"
		end_color=${PROMPT_RED}
	else
		user_part="${PROMPT_GREEN}\\u"
		end_color=${PROMPT_BLUE}
	fi

	# Render the full hostname with Bash's built-in prompt escape.
	host='\H'

	PS1="${PROMPT_BLUE}┌[${directory_color}\\w$(prompt_git)${PROMPT_BLUE}]${PROMPT_RESET}"$'\n'
	PS1+="${PROMPT_BLUE}└[$(prompt_battery)${user_part}@${host}$(prompt_ssh_indicator)${PROMPT_BLUE}]${PROMPT_RESET} ${end_color}\\\$ ${PROMPT_RESET}"
}

# shell_add_prompt_command is defined in bashrc, which sources this file.
shell_add_prompt_command prompt_update

PS2="${PROMPT_YELLOW}»···${PROMPT_BLUE}> ${PROMPT_RESET}"
PS3=$'\e[34mMake a selection: \e[0m'
PS4='+ ${BASH_SOURCE}:${LINENO}: '
