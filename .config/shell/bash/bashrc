# shellcheck shell=bash
# Bash options, history, Readline, and prompt hooks.
shopt -s failglob histappend
set -b
set -o vi
bind 'set bell-style visible'
bind -m vi-insert '"\C-l":clear-screen'
HISTCONTROL=ignoreboth:erasedups
HISTFILESIZE=200000

shell_sync_history() {
	history -a
	history -n
}

shell_read_char() {
	IFS= read -r -n 1 "$1"
}

# Preserve existing scalar or array prompt commands and avoid duplicate hooks.
if ! declare -p PROMPT_COMMAND 2>/dev/null | grep -q '^declare -a '; then
	if [[ -n ${PROMPT_COMMAND:-} ]]; then
		PROMPT_COMMAND=("$PROMPT_COMMAND")
	else
		PROMPT_COMMAND=()
	fi
fi
if [[ " ${PROMPT_COMMAND[*]} " != *' shell_sync_history '* ]]; then
	PROMPT_COMMAND+=(shell_sync_history)
fi

# shellcheck source=keybinds
source "${BDOTDIR}/keybinds"
# shellcheck source=prompt
source "${BDOTDIR}/prompt"
