root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = tab
tab_width = 8
# Some configuration values contain meaningful trailing whitespace.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 2

# Compiled Vim spell files are binary; never append a newline.
[vim/spell/*.{spl,sug}]
insert_final_newline = false

[cava/shaders/*]
indent_style = space
indent_size = 4

[cava/shaders/eye_of_phi.frag]
indent_size = 2
