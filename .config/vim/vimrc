" Vim configuration in one file. It works on its own, for example copied to
" ~/.vim/vimrc on a host without the dotfiles; settings that need a missing
" feature are skipped. Optional modules in conf.d/ beside it load if present.

" Set the encoding first; this file contains UTF-8 characters.
set encoding=utf-8
scriptencoding utf-8

" Let Vim find spell/ and conf.d/ beside this file, wherever it is installed.
let s:config_dir = expand('<sfile>:p:h')
execute 'set runtimepath^=' . fnameescape(s:config_dir)

" Optional Modules ------------------------------------------------------------
" plugins.vim installs vim-plug and loads plugins on the hosts it lists.
for s:module in ['plugins']
	let s:module_file = s:config_dir . '/conf.d/' . s:module . '.vim'
	if filereadable(s:module_file)
		execute 'source' fnameescape(s:module_file)
	endif
endfor
unlet s:module s:module_file

" Reload this file whenever it is saved
augroup vimrcreload
	autocmd!
	autocmd BufWritePost $MYVIMRC nested source $MYVIMRC
augroup END

" General Settings ------------------------------------------------------------

" Enable 24-bit colour, except on the Linux text console
if has('termguicolors') && $TERM !=# 'linux'
	set termguicolors
endif

" Turn on syntax highlighting; enable, unlike on, keeps highlights set here.
syntax enable

" Wrap long lines at word boundaries
set wrap linebreak

" Automatically load files changed outside Vim, checking whenever Vim regains
" focus or enters a buffer
set autoread
augroup autoread
	autocmd!
	autocmd FocusGained,BufEnter * silent! checktime
augroup END

" Vim requests focus reports only from xterm-like terminals. Alacritty and tmux
" (with focus-events on) send them too, so request them there as well.
if &term =~# '^\(alacritty\|tmux\)'
	let &t_fe = "\<Esc>[?1004h"
	let &t_fd = "\<Esc>[?1004l"
	execute "set <FocusGained>=\<Esc>[I"
	execute "set <FocusLost>=\<Esc>[O"
endif

" Show the file name in the window title
set title

" Keep backups in the cache, and swap and undo files, which recover work, in
" the state directory. The trailing // names each file after its full path.
let s:cache_home = empty($XDG_CACHE_HOME) ? expand('~/.cache') : $XDG_CACHE_HOME
let s:state_home = empty($XDG_STATE_HOME) ? expand('~/.local/state') : $XDG_STATE_HOME
let s:backup_dir = s:cache_home . '/vim/backup'
let s:swap_dir = s:state_home . '/vim/swap'
let s:undo_dir = s:state_home . '/vim/undo'
for s:dir in [s:backup_dir, s:swap_dir, s:undo_dir]
	if !isdirectory(s:dir)
		call mkdir(s:dir, 'p', 0700)
	endif
endfor
let &backupdir = escape(s:backup_dir, ' ,') . '//'
let &directory = escape(s:swap_dir, ' ,') . '//'
let &undodir = escape(s:undo_dir, ' ,') . '//'
set undofile

" Keep history, registers and file marks (viminfo) and netrw's browsing history
" with the other state. viminfo is set whole so a reload doesn't repeat it.
let &viminfo = "'100,<50,s10,h,n" . s:state_home . '/vim/viminfo'
let g:netrw_home = s:state_home . '/vim'
unlet s:cache_home s:state_home s:backup_dir s:swap_dir s:undo_dir s:dir

" Show incomplete commands at the bottom
set showcmd

" Show relative line numbers and highlight the current line
set number relativenumber
set cursorline

" Mark the 80th column as a line length guide
set colorcolumn=80

" Ignore trailing whitespace changes in diffs. Indentation changes still show,
" as they matter in YAML, Python and Makefiles; :set diffopt+=iwhite hides them.
set diffopt+=iwhiteeol

" Let the arrow keys and backspace move across line breaks
set whichwrap=bs<>[]

" Mark wrapped lines with '>   '; let avoids the escaped trailing space :set needs.
let &showbreak = '>   '

" Show tabs, non-breaking spaces and trailing spaces
set list listchars=nbsp:¬,tab:»·,trail:·,extends:>

" Highlight trailing whitespace, and spaces before tabs, in every window; a match
" applies to one window only. Colour schemes clear highlighting, so reapply it.
function! s:MatchExtraWhitespace() abort
	if !exists('w:extra_whitespace_match')
		let w:extra_whitespace_match = matchadd('ExtraWhitespace', '\s\+$\| \+\ze\t \| [^\t]\zs\t\+')
	endif
endfunction
hi ExtraWhitespace ctermbg=red guifg=red
augroup extrawhitespace
	autocmd!
	autocmd VimEnter,WinNew * call s:MatchExtraWhitespace()
	autocmd ColorScheme * hi ExtraWhitespace ctermbg=red guifg=red
	" Visual override, disabled for testing. It must run after the theme, so it
	" lives here; with termguicolors on, Vim uses gui=, guifg= and guibg= instead.
	"autocmd ColorScheme * hi Visual cterm=inverse ctermfg=green
augroup END

" Highlight all search matches, and show them while typing
set hlsearch incsearch

" Ignore case when searching unless the pattern contains a capital
set ignorecase smartcase

" Load plugin and indent settings for each detected file type
filetype plugin indent on

" Keep the cursor line vertically centred
set scrolloff=999

" Open splits below and to the right
set splitbelow splitright

" Always show the status line
set laststatus=2

" Indent with tabs, eight columns wide
set shiftwidth=8
set tabstop=8
set softtabstop=8
set noexpandtab

" Keep the previous line's indent on a new line
set autoindent

" Spelling languages, for file types with spell checking on (see Filetype
" Specific Settings). French is added only where a dictionary is installed.
let &spelllang = 'en_ca'
if !empty(globpath(&runtimepath, 'spell/fr.utf-8.spl'))
	let &spelllang .= ',fr'
endif

" Treat numbers with leading zeros as decimal, not octal, for CTRL-A and CTRL-X
set nrformats-=octal

" Show as much as fits of a long last line instead of a column of @
set display=truncate

" Don't continue comments automatically on new lines
augroup autocomments
	autocmd!
	autocmd FileType * setlocal fo-=c fo-=r fo-=o
augroup END

" Return to the last cursor position when reopening a file, except where
" starting at the top is expected: commit messages, rebase lists and hex dumps.
augroup restorecursor
	autocmd!
	autocmd BufReadPost *
		\ let s:last_line = line("'\"")
		\ | if s:last_line >= 1 && s:last_line <= line('$') && &filetype !~# 'commit'
		\ && index(['xxd', 'gitrebase'], &filetype) == -1
		\ | execute "normal! g`\""
		\ | endif
augroup END

" Make Escape respond quickly; 10ms still lets key codes arrive over slow SSH.
set timeoutlen=1000 ttimeoutlen=10

" Disable the mouse
set mouse=

" Use the system and selection clipboards, where Vim has clipboard support
if has('clipboard')
	set clipboard^=unnamed,unnamedplus
endif

" Keymaps ---------------------------------------------------------------------

" Fix Home and End under GNU Screen, whose key codes Vim doesn't recognise
if $TERM =~ '^screen-256color'
	map <Esc>OH <Home>
	map! <Esc>OH <Home>
	map <Esc>OF <End>
	map! <Esc>OF <End>
endif

" Move by screen lines through wrapped text. With a count, such as 5j, move by
" real lines so the relative line numbers stay accurate.
nnoremap <expr> k v:count ? 'k' : 'gk'
nnoremap <expr> j v:count ? 'j' : 'gj'
nnoremap <Home> g<Home>
nnoremap <End> g<End>
inoremap <C-o>k <C-o>gk
inoremap <C-o>j <C-o>gj
inoremap <Home> <C-o>g<Home>
inoremap <End> <C-o>g<End>

" In a terminal window, CTRL-D ends the shell and closes the window. This needs
" a Vim built with its terminal.
if has('terminal')
	tnoremap <silent><C-D> <C-D><C-\><C-N>ZQ
endif

" Abbreviations ---------------------------------------------------------------

" Expand TODO into a tagged note, but only when typed inside a comment
function! s:InComment() abort
	for l:id in synstack(line('.'), max([col('.') - 1, 1]))
		if synIDattr(synIDtrans(l:id), 'name') ==# 'Comment'
			return 1
		endif
	endfor
	return 0
endfunction
iabbrev <expr> TODO <SID>InComment() ? "(TODO[DN]:)\<Left>" : 'TODO'

" Filetype Specific Settings --------------------------------------------------

" Indentation
augroup indentation
	autocmd!
	autocmd FileType markdown setlocal shiftwidth=4 tabstop=4 softtabstop=4 expandtab
	autocmd FileType html setlocal shiftwidth=2 tabstop=2 softtabstop=2 expandtab
	autocmd FileType scss setlocal shiftwidth=2 tabstop=2 softtabstop=2 expandtab
augroup END

" No line length guide for Markdown
augroup linelengthwarn
	autocmd!
	autocmd FileType markdown setlocal colorcolumn=
augroup END

" Check spelling in prose only; :setlocal spell turns it on anywhere else.
augroup spelling
	autocmd!
	autocmd FileType markdown,text,gitcommit,mail,tex,rst,asciidoc setlocal spell
augroup END

" Conceal markup in Markdown and LaTeX so they read as text
augroup conceal
	autocmd!
	autocmd FileType markdown,tex setlocal conceallevel=2
augroup END

