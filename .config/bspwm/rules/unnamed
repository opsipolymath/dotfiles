#!/bin/sh

# Route unclassified Steam and Spotify windows to their desktops.
window_id="${1?}"
window_class="${2}"
pid_atom="_NET_WM_PID"
steam_desktop="^8"
spotify_desktop="^9"

exec 2>/dev/null

if [ -n "${window_class}" ]; then
	exit 0
fi

window_name="$(xprop -id "${window_id}" | grep '^WM_NAME' | cut -d= -f2)"
case "${window_name}" in
	*Steam*)
		printf 'desktop=%s\n' "${steam_desktop}"
		exit 0
		;;
esac

process_id="$(xprop -id "${window_id}" -notype -f "${pid_atom}" 32c '=$0' "${pid_atom}" | cut -d= -f2)"
process_name="$(ps -p "${process_id:?}" -o comm=)"
if [ "${process_name}" != spotify ]; then
	exit 0
fi

printf 'desktop=%s\n' "${spotify_desktop}"
