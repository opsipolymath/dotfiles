#!/usr/bin/env bash

# bspwm configuration and application startup; helpers and rules tolerate reloads.

# environment.d is systemd configuration, not shell code. Its generator handles
# quoting, expansion and file precedence, and emits Bash-compatible assignments.
load_environment() {
	local environment_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/environment.d"
	local environment_generator=/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator
	local generated_environment
	[[ -d ${environment_dir} ]] || return 0
	if [[ ! -x ${environment_generator} ]]; then
		printf 'Cannot load environment.d: systemd environment generator is unavailable\n' >&2
		return 0
	fi
	if ! generated_environment=$("${environment_generator}"); then
		printf 'Cannot load environment.d: generation failed; continuing with the inherited environment\n' >&2
		return 0
	fi
	set -a
	eval "${generated_environment}"
	set +a
}
load_environment
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
bspwm_config_dir="${config_home}/bspwm"
polybar_name="default"
user_id="${UID}"

# Set X options for bspwm
setxkbmap -option "ctrl:swapcaps"
xsetroot -cursor_name left_ptr

# Set a random wallpaper (from ~/Pictures/Wallpapers, else the packaged
# default); the lock screen gets a blurred copy of the same image.
set-wallpaper

# Set bspwm options
bspc monitor -d ᚠ ᚢ ᚦ ᚩ ᚱ ᚳ ᚷ ᚹ ᚻ
bspc config borderless_monocle true
bspc config single_monocle true
bspc config ignore_ewmh_focus true
bspc config gapless_monocle false
bspc config border_width 2
bspc config split_ratio 0.52

# Define colors
xresource_color() {
	xrdb -query | grep -E "^(bspwm|\*)\.${1}:" | tail -n 1 | awk '{print $2}'
}
xrdb "${config_home}/X11/Xresources"
bspc config window_gap "$(xresource_color gap)"
bspc config top_padding "$(xresource_color panelGap)"
bspc config focused_border_color "$(xresource_color activeColor)"
bspc config active_border_color "$(xresource_color normalColor)"
bspc config normal_border_color "$(xresource_color normalColor)"

# Start background helpers only when absent.
start_once() {
	if pgrep -u "${user_id}" -x "$1" >/dev/null 2>&1; then
		return 0
	fi
	"$@" &
}
start_once polybar -r "${polybar_name}"
# Publishes the GTK theme and font settings; start it before GTK helpers.
start_once xsettingsd
start_once lxpolkit
start_once picom
start_once sxhkd
start_once battery-notify
# Runs lock-screen for loginctl lock-session, the idle timeout and suspend.
start_once xss-lock --transfer-sleep-lock -- lock-screen
if ! pgrep -u "${user_id}" -x playerctld >/dev/null 2>&1; then
	playerctld daemon
fi

# Replace rules owned by this config, leaving unrelated runtime rules alone.
set_rule() {
	bspc rule -r "$1" >/dev/null 2>&1
	bspc rule -a "$@"
}

# Set permanent application positioning rules
set_rule "Vivaldi-stable" desktop=^2 follow=on
set_rule "paradox launcher" desktop=^3 follow=on state=floating
set_rule "steamwebhelper" desktop=^8
set_rule "steam" desktop=^8
set_rule "Emacs" state=tiled

# Move games to desktop 3
set_rule "eu4" desktop=^3 follow=on state=fullscreen
set_rule "RimWorldLinux" desktop=^3 follow=on state=fullscreen

# External window rules
bspc config external_rules_command "${bspwm_config_dir}/external_rules"

# Arm one-shot rules only when starting the corresponding application.
bspc rule -r kitty >/dev/null 2>&1
if ! pgrep -u "${user_id}" -x kitty >/dev/null 2>&1; then
	bspc rule -a kitty -o desktop=^1 follow=on
	kitty &
fi
if ! pgrep -u "${user_id}" vivaldi >/dev/null 2>&1; then
	bspc rule -a Vivaldi-stable -o desktop=^2 follow=off focus=off
	vivaldi &
fi
if ! pgrep -u "${user_id}" spotify >/dev/null 2>&1; then
	spotify &
fi

# Define initial layouts
for desktop in $(bspc query -D --names); do
	bsp-layout set tall "${desktop}" -- --master-size 0.6
done
bspc desktop ^8 --layout monocle
bspc desktop ^9 --layout monocle

# Unset variables
unset config_home bspwm_config_dir polybar_name user_id desktop
