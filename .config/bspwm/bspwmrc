#!/bin/sh

# bspwm configuration.

# Source optional shell environment fragments before deriving application paths.
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
environment_dir="${config_home}/environment.d"
if [ -d "${environment_dir}" ]; then
	for environment_file in "${environment_dir}"/*; do
		[ -f "${environment_file}" ] && . "${environment_file}"
	done
	unset environment_file
fi
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
bspwm_config_dir="${config_home}/bspwm"
rules_dir="${bspwm_config_dir}/rules"
polybar_name="default"

# Set X options for bspwm
setxkbmap -option "ctrl:swapcaps"
xsetroot -cursor_name left_ptr

# Set bspwm options
bspc monitor -d ᚠ ᚢ ᚦ ᚩ ᚱ ᚳ ᚷ ᚹ ᚻ
bspc config borderless_monocle true
bspc config single_monocle true
bspc config ignore_ewmh_focus true
bspc config gapless_monocle false
bspc config border_width 2
bspc config split_ratio 0.52

# Define colors
xresource_color() {
	xrdb -query | grep -E "^(bspwm|\*)\.${1}:" | tail -n 1 | awk '{print $2}'
}
xrdb "${config_home}/X11/Xresources"
bspc config window_gap "$(xresource_color gap)"
bspc config top_padding "$(xresource_color panelGap)"
bspc config focused_border_color "$(xresource_color activeColor)"
bspc config active_border_color "$(xresource_color normalColor)"
bspc config normal_border_color "$(xresource_color normalColor)"

# Start background helpers
polybar -r "${polybar_name}" &
lxpolkit &
picom &
sxhkd &
mpd-mpris &
blueman-applet &
playerctld daemon

# Set permanent application positioning rules
bspc rule -a "Vivaldi-stable" desktop=^2 follow=on
bspc rule -a "paradox launcher" desktop=^3 follow=on state=floating
bspc rule -a "steamwebhelper" desktop=^8
bspc rule -a "steam" desktop=^8
bspc rule -a "Emacs" state=tiled

# Move games to desktop 3
bspc rule -a "eu4" desktop=^3 follow=on state=fullscreen
bspc rule -a "RimWorldLinux" desktop=^3 follow=on state=fullscreen

# bspwm accepts one external rule handler.
bspc config external_rules_command "${rules_dir}/unnamed"

# Set temporary application rules for startup
bspc rule -a Vivaldi-stable -o desktop=^2 follow=off
bspc rule -a Alacritty -o desktop=^1 follow=on

# Startup user applications if not already running
pgrep -u "${USER}" alacritty >/dev/null 2>&1 || alacritty &

# Define initial layouts
for desktop in $(bspc query -D --names); do
	bsp-layout set tall "${desktop}" -- --master-size 0.6
done
bspc desktop ^8 --layout monocle
bspc desktop ^9 --layout monocle

# Unset variables
unset config_home bspwm_config_dir environment_dir rules_dir polybar_name desktop
