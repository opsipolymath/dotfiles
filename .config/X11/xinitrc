#!/bin/sh

# Simple xinitrc to load global config files and start bspwm

x11_config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/X11"

# Load any global configurations
global_xinit_dir=/etc/X11/xinit/xinitrc.d
if [ -d "${global_xinit_dir}" ]; then
	for startup_file in "${global_xinit_dir}"/*; do
		[ -x "${startup_file}" ] && . "${startup_file}"
	done
	unset startup_file
fi

# Load any user configurations
user_xinit_dir="${x11_config_dir}/xinitrc.d"
if [ -d "${user_xinit_dir}" ]; then
	for startup_file in "${user_xinit_dir}"/*; do
		[ -x "${startup_file}" ] && . "${startup_file}"
	done
	unset startup_file
fi

# Unset variables
unset x11_config_dir global_xinit_dir user_xinit_dir

# Launch window manager
exec bspwm
