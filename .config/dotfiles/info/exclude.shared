# Git exclusions for the dotfiles repository, shared by every host.
#
# Git reads info/exclude, not this file. On a fresh install, copy this file to
# info/exclude, then add any exclusions for that host only to the copy:
#   cp ~/.config/dotfiles/info/exclude.shared ~/.config/dotfiles/info/exclude

# Exclude everything by default; allow selected paths below
/*

# Never track uuid files
.uuid

# Track bash configuration files for now
!.bashrc
!.bash_profile

# Track .github directory
!.github

# Track configuration directory
!.config

# Ignore any unwanted loose files
.config/QtProject.conf
.config/mimeapps.list
.config/pavucontrol.ini
.config/user-dirs.locale
.config/user-dirs.dirs

# Ignore specific configuration directories
.config/aurutils/
.config/BraveSoftware/
.config/cef_user_data/
.config/chromium/
.config/dconf/
.config/doom/
.config/emacs/
.config/freerdp/
.config/google-chrome/
.config/gtk-*/
.config/heroic/
.config/irssi/
.config/midori/
.config/paradox-launcher*/
.config/pulse/
.config/rclone/
.config/repoctl/
.config/spotify*/
.config/ssh/
.config/systemd/user/default.target.wants/
.config/systemd/user/timers.target.wants/
.config/systemd/user/dbus-org.bluez.obex.service
.config/tor/
.config/unity3d/
.config/vlc/
.config/yams/
.config/Yubico/

# cmus - Ignore everything except config
.config/cmus/*
!.config/cmus/rc

# Code - Track settings, keybindings, and snippets
.config/Code - OSS/*
!.config/Code - OSS/User/
.config/Code - OSS/User/*
!.config/Code - OSS/User/settings.json
!.config/Code - OSS/User/keybindings.json
!.config/Code - OSS/User/snippets/

# ncspot - Track configuration only; exclude user state and authentication data
.config/ncspot/*
!.config/ncspot/config.toml

# neomutt - Track configuration, bindings, and theme; exclude account files
.config/neomutt/*
!.config/neomutt/neomuttrc
!.config/neomutt/keybinds
!.config/neomutt/nord

# Shell history and completion caches, including older layouts and other hosts
.config/**/.histfile
.config/**/.zcompdump*

# Ignore specific files in tracked directories
.config/cava/shaders/
.config/ncmpcpp/error.log
.config/tmux/plugins/
.config/vim/.netrwhist
.config/vim/autoload/

# Track the shared exclusion file only, not the repository or local exclusions
.config/dotfiles/*
!.config/dotfiles/info
.config/dotfiles/info/*
!.config/dotfiles/info/exclude.shared

# Track local directory
!.local

# Ignore any loose files but not directories
.local/*
!.local/*/

# Ignore specific local directories
.local/lib/
.local/state/

# Allow local share but not any files or directories
!.local/share/
.local/share/*

# Track gnupg configuration
!.local/share/gnupg
.local/share/gnupg/*
!.local/share/gnupg/gpg.conf
!.local/share/gnupg/gpg-agent.conf

# Track custom icons for dunst only
!.local/share/icons/
.local/share/icons/*
!.local/share/icons/dunst/

# Track custom fonts
!.local/share/fonts

# Backup files, merge leftovers, and editor swap files
*~
*.bak
*.orig
*.rej
*.swp
*.swo

# Local-only changes

# vim: set ft=cfg:
